# Public site URL (used for metadata, sitemap, robots)
NEXT_PUBLIC_SITE_URL=https://zyra.tech
# Contact form → Gmail SMTP (server-only, never use NEXT_PUBLIC_ prefix)
# 1. Enable 2-Step Verification on Zyracmt@gmail.com
# 2. Create App Password: Google Account → Security → App passwords → Mail / Zyra Website
# 3. Copy to .env.local as GMAIL_APP_PASSWORD (no spaces needed, they are stripped anyway)
GMAIL_USER=Zyracmt@gmail.com
GMAIL_APP_PASSWORD=
CONTACT_TO_EMAIL=Zyracmt@gmail.com
CONTACT_FROM_NAME=ZYRA Technologies
